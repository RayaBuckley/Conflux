_information"},{"description":"Get the address of the given hotel.","input_schema":{"properties":{"hotel_name":{"description":"The name of the hotel to get the address for.","title":"Hotel Name","type":"string"}},"required":["hotel_name"],"title":"Input schema for `get_hotels_address`","type":"object"},"upstream_id":"get_hotels_address"},{"description":"Get all hotels within the given budget, should be within the price range.","input_schema":{"properties":{"hotel_names":{"description":"The name of the hotel to get the price range for.","items":{"type":"string"},"title":"Hotel Names","type":"array"}},"required":["hotel_names"],"title":"Input schema for `get_hotels_prices`","type":"object"},"upstream_id":"get_hotels_prices"},{"description":"Get the price per person of the given restaurants.","input_schema":{"properties":{"restaurant_names":{"description":"The name of the restaurant to get the price per person for.","items":{"type":"string"},"title":"Restaurant Names","type":"array"}},"required":["restaurant_names"],"title":"Input schema for `get_price_for_restaurants`","type":"object"},"upstream_id":"get_price_for_restaurants"},{"description":"Get the rating and reviews for the given car rental companies.","input_schema":{"properties":{"company_name":{"description":"The name of the car rental company to get reviews for.","items":{"type":"string"},"title":"Company Name","type":"array"}},"required":["company_name"],"title":"Input schema for `get_rating_reviews_for_car_rental`","type":"object"},"upstream_id":"get_rating_reviews_for_car_rental"},{"description":"Get the rating and reviews for the given hotels.","input_schema":{"properties":{"hotel_names":{"description":"The names of the hotels to get reviews for.","items":{"type":"string"},"title":"Hotel Names","type":"array"}},"required":["hotel_names"],"title":"Input schema for `get_rating_reviews_for_hotels`","type":"object"},"upstream_id":"get_rating_reviews_for_hotels"},{"description":"Get the rating and reviews for t