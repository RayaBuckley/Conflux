r `get_all_restaurants_in_city`","type":"object"},"upstream_id":"get_all_restaurants_in_city"},{"description":"Get the fuel options of the given car rental companies.","input_schema":{"properties":{"company_name":{"description":"The name of the car rental company to get the fuel options for.","items":{"type":"string"},"title":"Company Name","type":"array"}},"required":["company_name"],"title":"Input schema for `get_car_fuel_options`","type":"object"},"upstream_id":"get_car_fuel_options"},{"description":"Get the price per day of the given car rental companies.","input_schema":{"properties":{"company_name":{"description":"The name of the car rental company to get the price per day for.","items":{"type":"string"},"title":"Company Name","type":"array"}},"required":["company_name"],"title":"Input schema for `get_car_price_per_day`","type":"object"},"upstream_id":"get_car_price_per_day"},{"description":"Get the address of the given car rental companies.","input_schema":{"properties":{"company_name":{"description":"The name of the car rental company to get the address for.","items":{"type":"string"},"title":"Company Name","type":"array"}},"required":["company_name"],"title":"Input schema for `get_car_rental_address`","type":"object"},"upstream_id":"get_car_rental_address"},{"description":"Get the car types available for the given car rental companies.","input_schema":{"properties":{"company_name":{"description":"The name of the car rental company to get the car types available for.","items":{"type":"string"},"title":"Company Name","type":"array"}},"required":["company_name"],"title":"Input schema for `get_car_types_available`","type":"object"},"upstream_id":"get_car_types_available"},{"description":"Get the contact information of the given restaurants.","input_schema":{"properties":{"restaurant_names":{"description":"The name of the restaurant to get the contact information for.","items":{"type":"string"},"title":"Restaurant Names","type":"array"}},"required":["restaurant_