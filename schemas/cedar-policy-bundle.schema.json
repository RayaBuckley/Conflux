{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/cedar-policy-bundle-v1.json",
  "title": "Pinned local Cedar policy bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "schema", "policies", "entities", "binary", "supported_features"],
  "properties": {
    "schema_version": {"const": "1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "schema": {"type": "object"},
    "policies": {"type": "string", "minLength": 1},
    "entities": {"type": "array"},
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "sha256"],
      "properties": {
        "version": {"const": "4.12.0"},
        "commit": {"const": "fdcbaed32bdb8c8d13e4eaf2b58db5555e9fb8c5"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "supported_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["parc", "json_schema", "entities_json", "request_context", "explicit_forbid"]
      }
    }
  }
}
