{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/experiment-manifest-v1.json",
  "title": "Conflux experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "suite", "suite_version", "source_commit",
    "defence", "bounds", "model", "provider", "policy", "seed", "machine",
    "output_directory", "rerun_command"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "suite": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "defence": {
      "enum": [
        "ites", "no_defence", "union_permissions", "initiator_only",
        "latest_input_only", "no_read_check"
      ]
    },
    "bounds": {"type": "object"},
    "model": {"type": "object"},
    "provider": {"type": "object"},
    "policy": {"type": "object"},
    "seed": {"type": "integer", "minimum": 0},
    "machine": {"type": "object"},
    "output_directory": {"type": "string", "minLength": 1},
    "rerun_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
