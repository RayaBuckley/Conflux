{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/local-artifact-manifest-v1.json",
  "title": "Conflux local artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "revision", "tokenizer_id", "tokenizer_revision", "files", "total_size"],
  "properties": {
    "schema_version": {"const": "1"},
    "model_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "tokenizer_id": {"type": "string", "minLength": 1},
    "tokenizer_revision": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "total_size": {"type": "integer", "minimum": 0}
  }
}
