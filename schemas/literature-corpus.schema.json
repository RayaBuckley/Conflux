{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/literature-corpus-v1.json",
  "title": "Conflux literature corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "2"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "year", "verified", "last_checked"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "authors": {"type": "array", "items": {"type": "string"}},
          "year": {"type": "integer"},
          "venue": {"type": "string"},
          "doi": {"type": "string"},
          "arxiv_id": {"type": "string"},
          "source_url": {"type": "string"},
          "verified": {
            "type": "object",
            "required": ["method", "date"],
            "properties": {
              "method": {"enum": ["primary_source", "scholar_metadata", "unverified"]},
              "depth": {"enum": ["full_text", "abstract_and_key_sections", "metadata_only", "unverified"]},
              "date": {"type": "string", "minLength": 1},
              "notes": {"type": "string"},
              "checked_by": {"type": "string"}
            }
          },
          "last_checked": {"type": "string", "minLength": 1},
          "adoption_priority": {"enum": ["A", "B", "C", "D"]},
          "evidence_tier": {"enum": ["A", "B", "C", "D"]},
          "closest_relation": {"type": "string"},
          "stream": {"type": "string"},
          "mechanism": {"type": "string"},
          "claim_refs": {"type": "array", "items": {"type": "string"}},
          "snowball_status": {
            "type": "object",
            "properties": {
              "backward": {"enum": ["done", "pending", "not_applicable"]},
              "forward": {"enum": ["done", "pending", "not_applicable"]}
            }
          },
          "reading_status": {"enum": ["not_started", "in_progress", "read", "skipped"]},
          "reading_priority": {"enum": ["A", "B", "C", "D"]},
          "source_type": {"enum": ["primary_paper", "survey", "technical_report", "standard", "framework", "system", "book"]},
          "relevance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "useful_parts": {"type": "string"},
              "conflux_relation": {"type": "string"},
              "key_findings": {"type": "array", "items": {"type": "string"}},
              "limitations": {"type": "array", "items": {"type": "string"}}
            }
          },
          "novelty_impact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "affected_claims": {"type": "array", "items": {"type": "string"}},
              "risk_level": {"enum": ["high", "medium", "low", "none"]},
              "qualification_needed": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
