{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/proposal-batch-v2.json",
  "title": "Conflux proposal batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "proposals"],
  "properties": {
    "schema_version": {"const": "2"},
    "mode": {"enum": ["alternatives", "ordered_plan"]},
    "proposals": {
      "type": "array",
      "items": {"oneOf": [
        {"$ref": "#/$defs/primitive"},
        {"$ref": "#/$defs/nested"},
        {"$ref": "#/$defs/message"},
        {"$ref": "#/$defs/delegation"},
        {"$ref": "#/$defs/stop"},
        {"$ref": "#/$defs/no_op"}
      ]}
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "resource_id", "resource_type", "attributes"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "resource_type": {"type": "string", "minLength": 1},
        "attributes": {"type": "object"}
      }
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "id", "kind", "visibility", "input_ids"],
      "properties": {
        "schema_version": {"const": "2"},
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string"},
        "visibility": {"enum": ["internal", "participants", "transcript"]},
        "input_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "value_fingerprint", "provenance", "redacted_value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["content", "resource", "recipient", "destination", "value", "credential_reference"]},
        "value_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_ids", "sources", "activities", "precision", "attested"],
          "properties": {
            "principal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "activities": {"type": "array", "items": {"type": "string"}},
            "precision": {"enum": ["exact", "conservative", "unknown"]},
            "attested": {"type": "boolean"}
          }
        },
        "redacted_value": {}
      }
    },
    "primitive": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "visibility", "input_ids", "operation", "permission", "resource", "arguments"],
          "properties": {
            "schema_version": {"const": "2"},
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "primitive"},
            "visibility": {"enum": ["internal", "participants", "transcript"]},
            "input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "operation": {"type": "string", "minLength": 1},
            "permission": {"type": "string", "minLength": 1},
            "resource": {"oneOf": [{"$ref": "#/$defs/resource"}, {"type": "null"}]},
            "arguments": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/argument"}
            }
          }
        }
      ]
    },
    "nested": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "visibility", "input_ids"],
          "properties": {
            "schema_version": {"const": "2"},
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "nested"},
            "visibility": {"enum": ["internal", "participants", "transcript"]},
            "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "message": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "visibility", "input_ids", "message"],
          "properties": {
            "schema_version": {"const": "2"},
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "message"},
            "visibility": {"enum": ["internal", "participants", "transcript"]},
            "input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "delegation": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "visibility", "input_ids", "scope"],
          "properties": {
            "schema_version": {"const": "2"},
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "delegation"},
            "visibility": {"enum": ["internal", "participants", "transcript"]},
            "input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "scope": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "stop": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "visibility", "input_ids", "reason"],
          "properties": {
            "schema_version": {"const": "2"},
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "stop"},
            "visibility": {"enum": ["internal", "participants", "transcript"]},
            "input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "reason": {"type": "string"}
          }
        }
      ]
    },
    "no_op": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "visibility", "input_ids", "label"],
          "properties": {
            "schema_version": {"const": "2"},
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "no_op"},
            "visibility": {"enum": ["internal", "participants", "transcript"]},
            "input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "label": {"type": "string"}
          }
        }
      ]
    }
  }
}
