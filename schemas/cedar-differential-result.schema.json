{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/cedar-differential-result-v1.json",
  "title": "Offline Cedar differential preflight result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "complete", "cedar_status", "reason", "bundle_fingerprint", "corpus_fingerprint", "request_count", "max_requests", "cases", "exclusions"],
  "properties": {
    "schema_version": {"const": "1"},
    "classification": {"const": "evaluation_ready"},
    "complete": {"const": false},
    "cedar_status": {"const": "unavailable"},
    "reason": {"const": "offline_preflight_does_not_invoke_cedar"},
    "bundle_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_count": {"type": "integer", "minimum": 0},
    "max_requests": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "oracle_allowed", "oracle_reason", "cedar_status", "cedar_decision", "translated_requests", "translation_denials"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "oracle_allowed": {"type": "boolean"},
          "oracle_reason": {"type": "string", "minLength": 1},
          "cedar_status": {"const": "unavailable"},
          "cedar_decision": {"type": "null"},
          "translated_requests": {"type": "array", "items": {"type": "object"}},
          "translation_denials": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
