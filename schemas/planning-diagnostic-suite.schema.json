{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/planning-diagnostic-suite-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "scenarios"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"const": "planning-diagnostic-v1"},
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "distinguishes", "principals", "actions", "revocations", "max_steps"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "distinguishes": {"type": "string", "minLength": 1},
          "principals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "permission", "resource_id", "context", "allowed_principals",
                "declared_reads", "declared_writes", "sensitive_read", "provider_failure", "goal"
              ],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "permission": {"type": "string", "minLength": 1},
                "resource_id": {"type": "string", "minLength": 1},
                "context": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "allowed_principals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "declared_reads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "declared_writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "sensitive_read": {"type": "boolean"},
                "provider_failure": {"type": "boolean"},
                "goal": {"type": "boolean"}
              }
            }
          },
          "revocations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "principal_id"],
              "properties": {
                "action_id": {"type": "string"},
                "principal_id": {"type": "string"}
              }
            }
          },
          "max_steps": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
