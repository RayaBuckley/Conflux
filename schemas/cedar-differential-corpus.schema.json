{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/cedar-differential-corpus-v1.json",
  "title": "Offline Cedar differential corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "max_requests", "cases"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "max_requests": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "principal_ids", "allowed_principal_ids", "argument_allowed_principal_ids", "argument_name", "argument_role", "argument_value", "resource_id", "resource_present", "explicit_forbid", "expected_reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "principal_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_principal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "argument_allowed_principal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "argument_name": {"type": "string", "minLength": 1},
          "argument_role": {"enum": ["resource", "recipient", "destination", "credential_reference"]},
          "argument_value": {"type": "string", "minLength": 1},
          "resource_id": {"type": "string", "minLength": 1},
          "resource_present": {"type": "boolean"},
          "explicit_forbid": {"type": "boolean"},
          "expected_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
