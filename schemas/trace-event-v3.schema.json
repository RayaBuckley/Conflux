{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/trace-event-v3.json",
  "title": "Conflux trace event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_type", "event_class", "event_id", "run_id", "branch_id",
    "sequence", "timestamp", "causal_parent_ids", "payload"
  ],
  "properties": {
    "schema_version": {"const": "3"},
    "event_class": {"enum": ["declaration", "decision", "outcome", "output", "error"]},
    "event_type": {
      "enum": [
        "run.started", "run.completed", "run.failed", "model.requested",
        "model.responded", "model.parse_failed", "proposal.observed",
        "policy.read_decided", "policy.action_decided",
        "policy.argument_decided",
        "policy.visibility_decided", "policy.consent_decided",
        "action.allowed", "action.blocked", "action.executed",
        "action.failed", "branch.created", "branch.completed",
        "bound.reached", "environment.changed",
        "plan.created", "plan.planner_responded", "plan.node_ready",
        "plan.node_started", "plan.node_succeeded", "plan.node_failed",
        "plan.node_blocked", "plan.model_responded", "plan.action_grounded",
        "plan.continuation_requested", "plan.patch_received",
        "plan.patch_applied", "plan.patch_rejected", "plan.loop_iteration",
        "plan.subplan_completed", "plan.completed", "plan.failed",
        "code.requested", "code.completed", "code.failed"
      ]
    },
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "node_id": {"type": ["string", "null"]},
    "branch_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "causal_parent_ids": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object"}
  }
}
