{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflux.example/schemas/experiment-protocol-v2.json",
  "title": "Conflux experiment protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "track", "suite", "source_commit", "inputs",
    "model", "prompts", "seeds", "repetitions", "bounds", "environment",
    "output_directory", "rerun_command"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "id": {"type": "string", "minLength": 1},
    "track": {"enum": ["native_sled", "agentdojo", "planning"]},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "inputs": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/localModel"}]},
    "prompts": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string"}
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_model_calls": {"type": "integer", "minimum": 0},
        "max_steps": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 0},
        "max_states": {"type": "integer", "minimum": 1},
        "max_transitions": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string"}
    },
    "output_directory": {"type": "string", "minLength": 1},
    "rerun_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "localModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend", "model_id", "revision", "weight_manifest_sha256",
        "tokenizer_id", "tokenizer_revision", "prompt_template_version",
        "seed", "temperature", "top_p", "max_output_tokens",
        "context_limit", "device", "dtype", "runtime_version"
      ],
      "properties": {
        "backend": {"enum": ["openai_compatible", "transformers"]},
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "weight_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "tokenizer_revision": {"type": "string", "minLength": 1},
        "prompt_template_version": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "context_limit": {"type": "integer", "minimum": 1},
        "device": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "endpoint": {"type": ["string", "null"]},
        "allow_private_remote": {"type": "boolean"}
      }
    }
  }
}
